# Base del backend. En desarrollo usar ruta relativa para el proxy de Vite.
# Desde el celular: http://<IP-LAN>:5173/api/... → Vite reenvía a 127.0.0.1:8000
VITE_API_BASE_URL=/api

# Overrides opcionales por endpoint (absolutos o relativos). Si se omiten,
# se construyen a partir de VITE_API_BASE_URL.
# VITE_BACKEND_API_BASE=/api/vehicle-positions
# VITE_BACKEND_API_BASE_SIMPLE=/api/vehicle-positions-simple
# VITE_BACKEND_SUBTE_API_BASE=/api/subtes
# VITE_BACKEND_SEMAFOROS_API_BASE=/api/transito/semaforos
# VITE_BACKEND_ECOBICI_STATION_INFORMATION_API_BASE=/api/ecobici/station-information
# VITE_BACKEND_ECOBICI_STATION_STATUS_API_BASE=/api/ecobici/station-status

# Stadia Maps (Alidade Smooth / Alidade Smooth Dark). Opcional en localhost.
# En producción conviene dominio autenticado o API key.
VITE_STADIA_MAPS_API_KEY=

# Thunderforest Transport / Transport Dark (mapa alternativo futuro).
# Requerido si se activa el preset thunderforest-transport.
VITE_THUNDERFOREST_API_KEY=
