# Base del backend consumida por el navegador (pública en el bundle).
# Desarrollo: ruta relativa → proxy de Vite → BACKEND_PROXY_TARGET
# Producción (Vercel): URL pública de Render, p.ej.
#   VITE_API_BASE_URL=https://transporte-publico-backend.onrender.com/api
VITE_API_BASE_URL=/api

# Obligatoria para npm run dev / preview (NO usar prefijo VITE_).
# Sin valor http(s) absoluto válido, Vite no arranca. No hay fallback.
# No se expone al navegador ni al bundle.
BACKEND_PROXY_TARGET=http://127.0.0.1:8000

# Stadia Maps (Alidade Smooth / Alidade Smooth Dark). Opcional en localhost.
# En producción conviene dominio autenticado o API key restringida por dominio.
VITE_STADIA_MAPS_API_KEY=

# Thunderforest Transport / Transport Dark (mapa alternativo futuro).
# Requerido si se activa el preset thunderforest-transport.
VITE_THUNDERFOREST_API_KEY=
